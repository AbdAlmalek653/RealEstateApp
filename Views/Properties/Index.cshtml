@model IEnumerable<RealEstateApp.Models.Property>

@{
    ViewData["Title"] = "تصفح العقارات المتاحة";
}

<!-- Header & Filter Bar -->
<div class="d-flex justify-content-between align-items-center my-4">
    <div>
        <h2 class="text-gradient fw-bold mb-1">العقارات المعروضة</h2>
        <p class="text-light opacity-75 small">استعرض الشقق والعقارات المتاحة للبيع المباشر</p>
    </div>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <a asp-action="Create" class="btn btn-gradient-primary">
            + أضف عقارك الآن
        </a>
    }
</div>

<!-- Quick Search Form -->
<div class="card glass-card p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-3">
            <input type="text"
                   name="searchQuery"
                   value="@Context.Request.Query["searchQuery"]"
                   class="form-control bg-dark text-white border-secondary"
                   placeholder="اسم العقار أو المدينة" />
        </div>

        <div class="col-md-2">
            <select name="governorate" class="form-select bg-dark text-white border-secondary">
                <option value="">جميع المحافظات</option>
                <option value="إدلب">إدلب</option>
                <option value="دمشق">دمشق</option>
                <option value="ريف دمشق">ريف دمشق</option>
                <option value="حلب">حلب</option>
                <option value="حمص">حمص</option>
                <option value="اللاذقية">اللاذقية</option>
                <option value="طرطوس">طرطوس</option>
                <option value="حماة">حماة</option>
            </select>
        </div>

        <div class="col-md-2">
            <select name="legalStatus" class="form-select bg-dark text-white border-secondary">
                <option value="">جميع أنواع الفراغة</option>
                <option value="طابو أخضر">طابو أخضر</option>
                <option value="مشاع بعقد تنازل">مشاع بعقد تنازل</option>
                <option value="بعقد تنازل">بعقد تنازل</option>
            </select>
        </div>

        <div class="col-md-2">
            <input type="number"
                   name="minPrice"
                   value="@Context.Request.Query["minPrice"]"
                   class="form-control bg-dark text-white border-secondary"
                   placeholder="السعر من"
                   min="0"
                   step="0.01" />
        </div>

        <div class="col-md-2">
            <input type="number"
                   name="maxPrice"
                   value="@Context.Request.Query["maxPrice"]"
                   class="form-control bg-dark text-white border-secondary"
                   placeholder="السعر إلى"
                   min="0"
                   step="0.01" />
        </div>

        <div class="col-md-1">
            <button type="submit" class="btn btn-outline-light w-100">بحث</button>
        </div>
    </form>

</div>

<!-- Properties Grid -->
@if (!Model.Any())
{
    <div class="card glass-card p-5 text-center my-4">
        <h4 class="text-light opacity-75">لا توجد عقارات مطابقة حالياً</h4>
        <p class="text-muted small">قم بتعديل خيارات البحث أو عد لاحقاً!</p>
    </div>
}
else
{
    <div class="row">
        @foreach (var item in Model)
        {
            var firstImage = item.Images != null && item.Images.Any()
                ? item.Images.FirstOrDefault()?.ImagePath
                : "https://via.placeholder.com/600x400?text=No+Image";

            <div class="col-md-4 mb-4">
                <div class="card glass-card h-100 text-white border-0 overflow-hidden d-flex flex-column">

                    <!-- Image & Status Badge -->
                    <div class="position-relative">
                        <img src="@firstImage" class="card-img-top" style="height: 220px; object-fit: cover;" alt="@item.Title" />

                        <span class="position-absolute top-0 end-0 bg-primary text-white px-3 py-1 m-3 rounded-pill fs-6 fw-bold shadow">
                            $@item.Price.ToString("N0")
                        </span>

                        @if (item.Status == RealEstateApp.Models.PropertyStatus.Sold)
                        {
                            <span class="position-absolute top-0 start-0 bg-danger text-white px-3 py-1 m-3 rounded-pill fs-6 fw-bold shadow">
                                تم البيع
                            </span>
                        }
                        else
                        {
                            <span class="position-absolute top-0 start-0 bg-success text-white px-3 py-1 m-3 rounded-pill fs-6 fw-bold shadow">
                                متاح
                            </span>
                        }
                    </div>

                    <!-- Card Content matching model attributes -->
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold text-white mb-2">@item.Title</h5>

                        <!-- Location: Governorate & City -->
                        <p class="card-text text-light opacity-75 small mb-2">
                            📍 <strong>@item.Governorate</strong> - @item.City
                        </p>

                        <!-- Features Badges: Area, Rooms, Legal Status -->
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="badge bg-dark border border-secondary text-light">📐 @item.Area م²</span>
                            <span class="badge bg-dark border border-secondary text-light">🚪 @item.RoomsCount غرف</span>
                            <span class="badge bg-info bg-opacity-20 text-info border border-info border-opacity-25">📄 @item.LegalStatus</span>
                        </div>

                        <p class="card-text text-light opacity-50 small flex-grow-1">
                            @(item.Description.Length > 85 ? item.Description.Substring(0, 85) + "..." : item.Description)
                        </p>
                    </div>

                    <!-- Card Footer: Seller & Direct Contact button -->
                    <div class="card-footer bg-transparent border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center py-3">
                        <small class="text-light opacity-75">👤 @(item.Seller?.FullName ?? "المالك")</small>
                        <div class="d-flex gap-2">
                            <a href="https://wa.me/@(item.PhoneDialCode.Replace("+", ""))@(item.PhoneNumber)" target="_blank" class="btn btn-sm btn-success" title="تواصل عبر الواتساب">
                                💬
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-gradient-primary btn-sm px-3">
                                التفاصيل
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
}