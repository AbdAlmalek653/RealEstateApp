@model RealEstateApp.Models.Property

<div class="container mt-3">
    <a asp-action="Index" class="btn btn-outline-light mb-3">&rarr; العودة للقائمة</a>

    <div class="row">
        <div class="col-md-8 mb-4">
            <!-- سلايدر عارض لجميع الصور المرفقة -->
            @if (Model.Images != null && Model.Images.Any())
            {
                <div id="propertyCarousel" class="carousel slide rounded overflow-hidden shadow-lg mb-4" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @for (int i = 0; i < Model.Images.Count; i++)
                        {
                            var img = Model.Images.ElementAt(i);
                            <div class="carousel-item @(i == 0 ? "active" : "")">
                                <img src="@img.ImagePath" class="d-block w-100" style="height: 450px; object-fit: cover;" alt="@Model.Title">
                            </div>
                        }
                    </div>
                    @if (Model.Images.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#propertyCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#propertyCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>
                    }
                </div>
            }
            else
            {
                <img src="https://via.placeholder.com/600x400?text=No+Image" class="img-fluid rounded w-100 mb-4" style="height: 400px; object-fit: cover;" />
            }

            <h2 class="text-gradient fw-bold">@Model.Title</h2>
            <h3 class="text-success mb-3">@Model.Price.ToString("N0") $</h3>
            <p><strong>الموقع:</strong> @Model.Location</p>
            <p><strong>تاريخ النشر:</strong> @Model.CreatedAt.ToString("yyyy/MM/dd")</p>
            <hr class="border-secondary" />
            <h5>الوصف التفصيلي</h5>
            <p>@Model.Description</p>
        </div>

        <!-- كارت التواصل مع البائع -->
        <div class="col-md-4">
            <div class="card glass-card p-3 text-white">
                <h5 class="text-gradient mb-3">معلومات التواصل مع البائع</h5>
                <p><strong>اسم البائع:</strong> @Model.Seller?.FullName</p>
                <p><strong>رقم الهاتف:</strong> <a href="tel:@Model.Seller?.PhoneNumber" class="text-info">@Model.Seller?.PhoneNumber</a></p>
                <p><strong>البريد الإلكتروني:</strong> @Model.Seller?.Email</p>

                @if (!string.IsNullOrEmpty(Model.Seller?.PhoneNumber))
                {
                    <a href="https://wa.me/@Model.Seller.PhoneNumber" class="btn btn-success w-100 mt-2" target="_blank">
                        تواصل عبر واتساب
                    </a>
                }
            </div>
        </div>
    </div>
</div>