@model RealEstateApp.Models.Property

@{
    ViewData["Title"] = Model.Title;
    var adminWhatsappNumber = "963912345678"; // رقم الواتساب الخاص بك كأدمن وسيط

    // تجهيز نص الرسالة بأمان بدون التباس في رموز الـ Razor
    var messageText = Uri.EscapeDataString($"مرحباً، أرغب بالاستفسار عن العقار: {Model.Title} (كود: {Model.Id})");
}

<div class="container my-5">
    <div class="row g-4">
        <!-- معرض الصور -->
        <div class="col-lg-7">
            <div class="card glass-card p-3 overflow-hidden">
                <div id="propertyCarousel" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner rounded">
                        @if (Model.Images != null && Model.Images.Any())
                        {
                            var first = true;
                            foreach (var img in Model.Images)
                            {
                                <div class="carousel-item @(first ? "active" : "")">
                                    <img src="@img.ImagePath" class="d-block w-100" style="height: 420px; object-fit: cover;" alt="@Model.Title">
                                </div>
                                first = false;
                            }
                        }
                        else
                        {
                            <div class="carousel-item active">
                                <img src="https://via.placeholder.com/800x500?text=No+Image" class="d-block w-100" style="height: 420px; object-fit: cover;" alt="No Image Available">
                            </div>
                        }
                    </div>

                    @if (Model.Images != null && Model.Images.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#propertyCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">السابق</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#propertyCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">التالي</span>
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- المواصفات والتواصل مع الأدمن -->
        <div class="col-lg-5">
            <div class="card glass-card p-4 text-white h-100 d-flex flex-column justify-content-between">
                <div>
                    <!-- حالة العقار والموقع -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge @(Model.Status == RealEstateApp.Models.PropertyStatus.Available ? "bg-success" : "bg-danger") fs-6 px-3 py-2">
                            @(Model.Status == RealEstateApp.Models.PropertyStatus.Available ? "🟢 متاح للبيع" : "🔴 تم البيع")
                        </span>
                        <span class="text-light opacity-75 small">📍 @Model.Governorate - @Model.City</span>
                    </div>

                    <h2 class="fw-bold text-gradient mb-4">@Model.Title</h2>

                    <!-- كروت المواصفات العصرية -->
                    <div class="row g-2 mb-4 text-center">
                        <div class="col-4">
                            <div class="p-3 bg-dark bg-opacity-50 rounded border border-secondary">
                                <small class="text-light opacity-75 d-block">المساحة</small>
                                <strong class="fs-5">@Model.Area م²</strong>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 bg-dark bg-opacity-50 rounded border border-secondary">
                                <small class="text-light opacity-75 d-block">الغرف</small>
                                <strong class="fs-5">@Model.RoomsCount غرف</strong>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-3 bg-dark bg-opacity-50 rounded border border-secondary">
                                <small class="text-light opacity-75 d-block">نوع الفراغة</small>
                                <strong class="fs-6 text-warning">@Model.LegalStatus</strong>
                            </div>
                        </div>
                    </div>

                    <h5 class="fw-bold mb-2">الوصف:</h5>
                    <p class="text-light opacity-75 mb-4">@Model.Description</p>
                </div>

                <!-- التكلفة والتواصل في أسفل الكارت -->
                <div class="border-top border-secondary pt-3 mt-3">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fs-5 text-light opacity-75">السعر النهائي:</span>
                        <h2 class="text-gradient fw-bold mb-0">@Model.Price.ToString("N0") $</h2>
                    </div>

                    @if (Model.Status == RealEstateApp.Models.PropertyStatus.Available)
                    {
                        <a asp-controller="Properties" asp-action="ContactAdmin" asp-route-id="@Model.Id" asp-route-type="WhatsApp"
                           target="_blank" class="btn btn-success w-100 py-3 fs-5 fw-bold shadow">
                            💬 التواصل لشراء العقار (عبر الأدمن المسؤول)
                        </a>
                    }
                    else
                    {
                        <button disabled class="btn btn-secondary w-100 py-2">هذا العقار مباع حالياً</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>