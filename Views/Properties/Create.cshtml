@model RealEstateApp.ViewModels.CreatePropertyViewModel

@{
    ViewData["Title"] = "إضافة عقار جديد";
}

<div class="row justify-content-center my-4">
    <div class="col-lg-9 col-md-10">
        <div class="card glass-card p-4 p-md-5 text-white border-0 shadow-lg">

            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                <div>
                    <h3 class="text-gradient fw-bold mb-1">➕ إضافة عقار جديد</h3>
                    <p class="text-light opacity-75 small mb-0">أدخل كافة التفاصيل والمواصفات الخاصة بالعقار بدقة</p>
                </div>
                <a asp-controller="Properties" asp-action="Index" class="btn btn-outline-light btn-sm px-3">&larr; العودة للقائمة</a>
            </div>

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger bg-opacity-25 text-white border-0 mb-4 rounded-3"></div>

                <!-- عنوان العقار -->
                <div class="mb-4">
                    <label asp-for="Title" class="form-label fw-bold"></label>
                    <input asp-for="Title" class="form-control bg-dark text-white border-secondary py-2" placeholder="مثال: شقة فاخرة للبيع في موقع مميز" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <!-- الموقع: المحافظة والمدينة -->
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Governorate" class="form-label fw-bold"></label>
                        <input asp-for="Governorate" class="form-control bg-dark text-white border-secondary py-2" placeholder="مثال: دمشق، حلب..." />
                        <span asp-validation-for="Governorate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="City" class="form-label fw-bold"></label>
                        <input asp-for="City" class="form-control bg-dark text-white border-secondary py-2" placeholder="مثال: المزة، الميدان..." />
                        <span asp-validation-for="City" class="text-danger small"></span>
                    </div>
                </div>

                <!-- المواصفات: المساحة بشكل رأسي ومستقل، الغرف، ونوع الفراغة -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label asp-for="Area" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <input asp-for="Area" type="number" step="0.1" class="form-control bg-dark text-white border-secondary py-2" placeholder="150" />
                            <span class="input-group-text bg-secondary bg-opacity-25 text-light border-secondary">م²</span>
                        </div>
                        <span asp-validation-for="Area" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="RoomsCount" class="form-label fw-bold"></label>
                        <input asp-for="RoomsCount" type="number" class="form-control bg-dark text-white border-secondary py-2" placeholder="4" />
                        <span asp-validation-for="RoomsCount" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="LegalStatus" class="form-label fw-bold"></label>
                        <select asp-for="LegalStatus" class="form-select bg-dark text-white border-secondary py-2">
                            <option value="طابو أخضر">طابو أخضر</option>
                            <option value="مشاع بعقد تنازل">مشاع بعقد تنازل</option>
                            <option value="بعقد تنازل">بعقد تنازل</option>
                        </select>
                        <span asp-validation-for="LegalStatus" class="text-danger small"></span>
                    </div>
                </div>

                <!-- معلومات التواصل معي صاحب العقار (النداء والهاتف) -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label asp-for="PhoneDialCode" class="form-label fw-bold"></label>
                        <select asp-for="PhoneDialCode" class="form-select bg-dark text-white border-secondary py-2">
                            <option value="+963">سوريا (+963)</option>
                            <option value="+966">السعودية (+966)</option>
                            <option value="+971">الإمارات (+971)</option>
                            <option value="+90">تركيا (+90)</option>
                            <option value="+962">الأردن (+962)</option>
                        </select>
                        <span asp-validation-for="PhoneDialCode" class="text-danger small"></span>
                    </div>
                    <div class="col-md-8">
                        <label asp-for="PhoneNumber" class="form-label fw-bold"></label>
                        <input asp-for="PhoneNumber" class="form-control bg-dark text-white border-secondary py-2" placeholder="912345678" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                </div>

                <!-- الوصف التفصيلي -->
                <div class="mb-4">
                    <label asp-for="Description" class="form-label fw-bold"></label>
                    <textarea asp-for="Description" class="form-control bg-dark text-white border-secondary" rows="4" placeholder="اكتب تفاصيل إضافية مثل الإكساء، الاتجاه، الطابق..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <!-- السعر المطلوب -->
                <div class="mb-4">
                    <label asp-for="Price" class="form-label fw-bold"></label>
                    <div class="input-group">
                        <input asp-for="Price" type="number" step="100" class="form-control bg-dark text-white border-secondary py-2" placeholder="50000" />
                        <span class="input-group-text bg-secondary bg-opacity-25 text-light border-secondary">$</span>
                    </div>
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <!-- رفع صور متعددة -->
                <div class="mb-5">
                    <label asp-for="ImageFiles" class="form-label fw-bold"></label>
                    <input asp-for="ImageFiles" type="file" multiple class="form-control bg-dark text-white border-secondary py-2" accept="image/*" />
                    <span asp-validation-for="ImageFiles" class="text-danger small"></span>
                    <small class="text-light opacity-50 d-block mt-1">يمكنك اختيار أكثر من صورة معاً للعقار.</small>
                </div>

                <button type="submit" class="btn btn-gradient-primary w-100 py-3 fs-5 fw-bold shadow">
                    حفظ ونشر العقار
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}