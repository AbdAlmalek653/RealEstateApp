@model RealEstateApp.ViewModels.CreatePropertyViewModel

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card glass-card p-4 text-white">
            <h3 class="text-gradient mb-4">إضافة عقار جديد</h3>

            <!-- إضافة enctype للتمكن من رفع الملفات -->
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control bg-dark text-white border-secondary" />
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label"></label>
                    <input asp-for="Price" type="number" class="form-control bg-dark text-white border-secondary" />
                </div>

                <div class="mb-3">
                    <label asp-for="Location" class="form-label"></label>
                    <input asp-for="Location" class="form-control bg-dark text-white border-secondary" />
                </div>

                <!-- حقل رفع صور متعددة -->
                <div class="mb-3">
                    <label asp-for="ImageFiles" class="form-label"></label>
                    <input asp-for="ImageFiles" type="file" multiple class="form-control bg-dark text-white border-secondary" accept="image/*" />
                    <span asp-validation-for="ImageFiles" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control bg-dark text-white border-secondary" rows="4"></textarea>
                </div>

                <button type="submit" class="btn btn-gradient-primary w-100">حفظ ونشر العقار</button>
            </form>
        </div>
    </div>
</div>