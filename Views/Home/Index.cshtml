@model IEnumerable<RealEstateApp.Models.Property>

@{
    ViewData["Title"] = "الصفحة الرئيسية - عقاراتك";
}

<!-- Hero Section - الواجهة الترحيبية -->
<div class="row align-items-center my-5 py-3">
    <div class="col-lg-7 text-end mb-4 mb-lg-0">
        <span class="badge bg-primary bg-opacity-20 text-primary px-3 py-2 rounded-pill fs-6 mb-3 border border-primary border-opacity-25">
            ✨ المنصة العقارية الأحدث والأسهل
        </span>
        <h1 class="display-4 fw-bold text-gradient mb-3">
            وجهتك الأولى لاكتشاف أفضل العقارات
        </h1>
        <p class="lead text-light opacity-75 mb-4">
            استكشف مجموعة واسعة من العقارات الشقق، الفلل، والأراضي. تواصل مباشرة مع المالكين بدون وسيط أو عمولات خفية.
        </p>
        <div class="d-flex gap-3 flex-wrap">
            <a asp-controller="Properties" asp-action="Index" class="btn btn-gradient-primary btn-lg px-4 fs-6">
                تصفح كافة العقارات &larr;
            </a>
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <a asp-controller="Properties" asp-action="Create" class="btn btn-outline-light btn-lg px-4 fs-6">
                    + أضف عقاراً جديداً
                </a>
            }
        </div>
    </div>

    <!-- بطاقات إحصائية عصرية -->
    <div class="col-lg-5">
        <div class="row g-3">
            <div class="col-6">
                <div class="card glass-card p-4 text-center">
                    <h2 class="text-gradient fw-bold mb-1">@Model.Count()</h2>
                    <p class="text-light opacity-75 mb-0">أحدث العقارات</p>
                </div>
            </div>
            <div class="col-6">
                <div class="card glass-card p-4 text-center">
                    <h2 class="text-gradient fw-bold mb-1">100%</h2>
                    <p class="text-light opacity-75 mb-0">تواصل مباشر</p>
                </div>
            </div>
            <div class="col-12">
                <div class="card glass-card p-4 d-flex flex-row align-items-center gap-3">
                    <div class="fs-1 text-primary">💬</div>
                    <div>
                        <h6 class="fw-bold mb-1 text-white">تواصل سريع وفعال</h6>
                        <small class="text-light opacity-75">اتصل بالبائعين فوراً عبر الهاتف أو الواتساب بنقرة زر.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<hr class="border-secondary my-5 opacity-25" />

<!-- قسم أحدث العقارات Grid -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="text-gradient fw-bold mb-1">أحدث العقارات المضافة</h3>
        <p class="text-light opacity-75 mb-0 small">استعرض آخر العروض العقارية المتاحة حالياً</p>
    </div>
    <a asp-controller="Properties" asp-action="Index" class="btn btn-outline-light btn-sm">عرض الكل &larr;</a>
</div>

@if (!Model.Any())
{
    <div class="card glass-card p-5 text-center my-4">
        <h4 class="text-light opacity-75">لا توجد عقارات معروضة حالياً</h4>
        <p class="text-muted mb-0">كن أول من يضيف عقاراً في المنصة!</p>
    </div>
}
else
{
    <div class="row">
        @foreach (var item in Model)
        {
            var firstImage = item.Images != null && item.Images.Any()
                ? item.Images.FirstOrDefault()?.ImagePath
                : "https://via.placeholder.com/600x400?text=No+Image";

            <div class="col-md-4 mb-4">
                <div class="card glass-card h-100 text-white overflow-hidden border-0">
                    <div class="position-relative">
                        <img src="@firstImage" class="card-img-top" style="height: 220px; object-fit: cover;" alt="@item.Title" />
                        <span class="position-absolute top-0 end-0 bg-primary text-white px-3 py-1 m-3 rounded-pill fs-6 fw-bold shadow">
                            $@item.Price.ToString("N0")
                        </span>
                    </div>

                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold text-white mb-2">@item.Title</h5>

                        <!-- التعديل هنا: استخدام Governorate و City بدلاً من Location -->
                        <p class="card-text text-light opacity-75 small mb-2">
                            📍 <strong>@item.Governorate</strong> - @item.City
                        </p>

                        <!-- إضافة شارات المساحة والغرف ونوع الفراغة -->
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="badge bg-dark border border-secondary text-light">📐 @item.Area م²</span>
                            <span class="badge bg-dark border border-secondary text-light">🚪 @item.RoomsCount غرف</span>
                            <span class="badge bg-info bg-opacity-20 text-info border border-info border-opacity-25">📄 @item.LegalStatus</span>
                        </div>

                        <p class="card-text text-light opacity-50 small flex-grow-1">
                            @(item.Description.Length > 80 ? item.Description.Substring(0, 80) + "..." : item.Description)
                        </p>
                    </div>

                    <div class="card-footer bg-transparent border-top border-secondary border-opacity-25 d-flex justify-content-between align-items-center py-3">
                        <small class="text-light opacity-75">👤 @(item.Seller?.FullName ?? "غير معروف")</small>
                        <a asp-controller="Properties" asp-action="Details" asp-route-id="@item.Id" class="btn btn-gradient-primary btn-sm px-3">
                            التفاصيل
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}