@{
    ViewData["Title"] = "إنشاء حساب أدمن جديد";
}

<div class="row justify-content-center my-5">
    <div class="col-md-7">
        <div class="card glass-card p-4 text-white">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="text-gradient fw-bold mb-0">👤 إنشاء حساب أدمن جديد</h3>
                <a asp-action="Users" class="btn btn-outline-light btn-sm">&larr; العودة للمستخدمين</a>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger bg-danger bg-opacity-25 text-white border-0 mb-3">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <form asp-action="CreateAdmin" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">الاسم الكامل</label>
                    <input type="text" name="fullName" class="form-control bg-dark text-white border-secondary" required placeholder="مثال: أحمد العلي" />
                </div>

                <div class="mb-3">
                    <label class="form-label">البريد الإلكتروني</label>
                    <input type="email" name="email" class="form-control bg-dark text-white border-secondary" required placeholder="admin@domain.com" />
                </div>

                <div class="mb-4">
                    <label class="form-label">كلمة المرور</label>
                    <input type="password" name="password" class="form-control bg-dark text-white border-secondary" required placeholder="******" />
                </div>

                <button type="submit" class="btn btn-gradient-primary w-100 py-2 fs-5">إضافة الأدمن فوراً</button>
            </form>
        </div>
    </div>
</div>