@model RealEstateApp.ViewModels.EditAdminProfileViewModel

@{
    ViewData["Title"] = "تعديل بيانات حساب الأدمن";
}

<div class="row justify-content-center my-5">
    <div class="col-lg-6">
        <div class="card glass-card p-4 p-md-5 text-white shadow-lg border-0">
            <div class="text-center mb-4">
                <span class="fs-1">⚙️</span>
                <h3 class="fw-bold text-gradient mt-2 mb-1">تعديل بيانات الحساب</h3>
                <p class="text-light opacity-75 small">تعديل معلومات الحساب الشخصي وكلمة المرور</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success bg-success bg-opacity-20 text-white border-0 text-center mb-4">
                    @TempData["SuccessMessage"]
                </div>
            }

            <form asp-action="EditProfile" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <!-- Full Name -->
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label text-light small fw-bold"></label>
                    <input asp-for="FullName" class="form-control bg-dark text-white border-secondary" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <!-- Email -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label text-light small fw-bold"></label>
                    <input asp-for="Email" class="form-control bg-dark text-white border-secondary" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <!-- Phone -->
                <div class="mb-3">
                    <label asp-for="PhoneNumber" class="form-label text-light small fw-bold"></label>
                    <input asp-for="PhoneNumber" class="form-control bg-dark text-white border-secondary text-end" dir="ltr" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>

                <hr class="border-secondary my-4 opacity-25" />

                <!-- New Password -->
                <div class="mb-4">
                    <label asp-for="NewPassword" class="form-label text-light small fw-bold"></label>
                    <input asp-for="NewPassword" class="form-control bg-dark text-white border-secondary" placeholder="••••••••" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-gradient-primary flex-grow-1 py-2 fw-bold">
                        حفظ التعديلات
                    </button>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light px-4">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}