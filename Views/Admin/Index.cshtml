@{
    ViewData["Title"] = "لوحة تحكم الأدمن";
}

<h2 class="mb-4">لوحة تحكم الأدمن</h2>

<div class="row">
    <div class="col-md-6 mb-3">
        <div class="card bg-primary text-white shadow-sm">
            <div class="card-body text-center">
                <h3>@ViewBag.UsersCount</h3>
                <p class="mb-2">إجمالي الحسابات المسجلة</p>
                <a asp-action="Users" class="btn btn-light btn-sm fw-bold">إدارة المستخدمين &rarr;</a>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card bg-success text-white shadow-sm">
            <div class="card-body text-center">
                <h3>@ViewBag.PropertiesCount</h3>
                <p class="mb-2">إجمالي العقارات المضافة</p>
                <a asp-action="Properties" class="btn btn-light btn-sm fw-bold">إدارة العقارات &rarr;</a>
            </div>
        </div>
    </div>
</div>